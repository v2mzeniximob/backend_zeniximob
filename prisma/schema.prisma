generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS MASTER DA PLATAFORMA
// ==========================================
model MasterAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PLANOS DE ASSINATURA
// ==========================================
model Plan {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  modules      Json         // Array de módulos permitidos (ex: ["FINANCEIRO", "CRM"])
  hasSupport   Boolean      @default(false)
  supportPrice Decimal?     @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  
  realEstates  RealEstate[] // Relacionamento com as imobiliárias

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// FRANQUEADOS
// ==========================================
model Franchisee {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String       // Razão Social
  tradeName         String       // Nome Fantasia
  stateRegistration String?      // Inscrição Estadual
  cityRegistration  String?      // Inscrição Municipal
  cep               String
  address           String       // Endereço Completo
  phone             String
  
  // Dados do Responsável
  respName          String
  respCpf           String
  respAddress       String
  respPhone         String
  
  // Acesso à plataforma
  email             String       @unique
  password          String
  contractUrl       String?      // Link do PDF do contrato no Storage (S3/Cloudinary)
  isActive          Boolean      @default(true)

  realEstates       RealEstate[] // Lojas vinculadas a este franqueado

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// IMOBILIÁRIAS (LOJAS)
// ==========================================
model RealEstate {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String
  tradeName         String
  slug              String       @unique 
  stateRegistration String
  cityRegistration  String
  cep               String
  address           String
  phone             String
  respName          String
  respCpf           String
  respPhone         String
  respAddress       String
  email             String       @unique
  password          String
  contractUrl       String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  logoUrl         String?   // Logótipo da imobiliária
  heroImageUrl    String?   // Imagem de fundo gigante para a barra de pesquisa
  aboutText       String?   // Texto para a página "Sobre nós"
  footerText      String?   // Texto curto para o rodapé
  instagramUrl    String?   // Link do Instagram
  facebookUrl     String?   // Link do Facebook
  whatsappDisplay String?   // WhatsApp público para o site

  planId            String
  plan              Plan         @relation(fields: [planId], references: [id])
  
  franchiseeId      String?
  franchisee        Franchisee?  @relation(fields: [franchiseeId], references: [id])

  ownerContractTemplate   String? @db.Text // Molde do contrato de Gestão (Proprietário)
  tenantContractTemplate  String? @db.Text // Molde do contrato de Locação (Inquilino)

  mpAccessToken   String? @db.Text // Token de Acesso Privado
  mpPublicKey     String? @db.Text // Chave Pública

  properties        Property[]
  leads             Lead[]
  brokers           Broker[]
  tenants           Tenant[]
  owners            Owner[]      // NOVO: Relacionamento com Proprietários
}

// ==========================================
// CORRETORES (Equipa da Loja)
// ==========================================
model Broker {
  id               String     @id @default(uuid())
  name             String
  cpf              String     @unique
  creci            String
  phone            String
  email            String     @unique
  password         String
  isActive         Boolean    @default(true)
  profileImageUrl  String?    @db.Text
  creciDocumentUrl String?    @db.Text
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  properties   Property[]
  leads        Lead[]
  visits       Visit[]    // NOVO: Relacionamento com as visitas agendadas

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// PROPRIETÁRIOS (NOVO)
// ==========================================
model Owner {
  id                    String     @id @default(uuid())
  name                  String
  cpfOrCnpj             String
  email                 String?
  phone                 String?
  bankData              String?    @db.Text // Dados bancários para repasse financeiro
  password              String?    // Acesso ao Portal do Proprietário
  isActive              Boolean    @default(true)
  managementContractUrl String?    @db.Text
  contractToken         String?    // <-- ESTA É A LINHA MÁGICA QUE FALTAVA!

  realEstateId          String
  realEstate            RealEstate @relation(fields: [realEstateId], references: [id])
  properties            Property[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("owners")
}

// ==========================================
// IMÓVEIS
// ==========================================
model Property {
  id            String      @id @default(uuid())
  title         String
  type          String      // Casa, Apartamento, Terreno, etc.
  category      String      // Residencial ou Comercial
  transaction   String      // Venda ou Aluguel
  
  // Valores
  price         Float
  condoFee      Float?      @default(0) // Valor do Condomínio
  iptu          Float?      @default(0) // Valor do IPTU Mensal/Anual
  
  // Detalhes Físicos
  area          Float
  bedrooms      Int         @default(0)
  bathrooms     Int         @default(0)
  garage        Int         @default(0)
  yearBuilt     Int?        // Ano de construção
  amenities     String[]    // Array com as características
  
  // Localização Detalhada
  cep           String
  address       String
  neighborhood  String?     
  city          String?     
  state         String?     
  latitude      Float?      
  longitude     Float?      
  
  // Mídia e Status
  description   String?
  imageUrls     String[]    
  isActive      Boolean     @default(true)
  
  // Relacionamentos
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  ownerId       String?     // NOVO: Relacionamento com Proprietário
  owner         Owner?      @relation(fields: [ownerId], references: [id])

  rentStatus      String?   @default("Vago") // "Vago" ou "Alugado"
  inspectionUrl   String?   // Upload do Documento de Vistoria
  contractUrl     String?   // Upload do Contrato de Aluguel
  isHighlighted   Boolean   @default(false)

  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  
  leads           Lead[]
  visits          Visit[]     // NOVO: Controle de visitas
  contracts       Contract[]  // NOVO: Contratos associados ao imóvel

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// INQUILINOS
// ==========================================
model Tenant {
  id              String      @id @default(uuid())
  
  // Dados do Inquilino
  name            String
  cpf             String      @unique
  currentAddress  String
  phone           String
  email           String
  documentUrl     String?     
  maritalStatus   String      
  
  // Dados do Cônjuge
  spouseName      String?
  spouseCpf       String?
  spouseDocUrl    String?     
  
  // Dados do Fiador
  guarantorName   String?
  guarantorCpf    String?
  guarantorDocUrl String?     
  
  // Controle do sistema
  isActive        Boolean     @default(true)
  
  // Relações
  realEstateId    String
  realEstate      RealEstate  @relation(fields: [realEstateId], references: [id])
  properties      Property[]  
  contracts       Contract[]  // NOVO: Contratos do inquilino
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("tenants")
}

// ==========================================
// LEADS (CRM)
// ==========================================
model Lead {
  id            String      @id @default(uuid())
  name          String
  phone         String
  email         String?
  interest      String      // Comprar, Alugar, etc.
  status        String      @default("Novo") // Novo, Em Atendimento, Em Proposta, Fechado, Perdido
  notes         String?
  
  // NOVO: Estágio do Funil (Pipeline)
  stage         String      @default("Novo") 
  
  propertyId    String?
  property      Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  history       LeadHistory[] // NOVO: Histórico de atendimento

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// NOVO: HISTÓRICO DE ATENDIMENTO DO LEAD
model LeadHistory {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType  String   // "WhatsApp", "Ligação", "E-mail", "Visita", "Anotação"
  description String   @db.Text
  date        DateTime @default(now())
}

// ==========================================
// CONTROLE DE VISITAS (NOVO)
// ==========================================
model Visit {
  id           String   @id @default(uuid())
  date         DateTime
  status       String   @default("Agendada") // Agendada, Realizada, Cancelada
  feedback     String?  @db.Text
  
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  brokerId     String
  broker       Broker   @relation(fields: [brokerId], references: [id])
  
  createdAt    DateTime @default(now())
}

// ==========================================
// CONTRATOS (NOVO)
// ==========================================
model Contract {
  id                String       @id @default(uuid())
  type              String       // "Locação", "Administração"
  status            String       @default("Minuta") // Minuta, Aguardando Assinatura, Ativo, Encerrado
  
  startDate         DateTime
  endDate           DateTime?
  
  rentValue         Float        
  adminFeePercent   Float        
  readjustmentIndex String?     
  
  // Controle de Assinatura Eletrônica
  documentUrl       String?      @db.Text // PDF original ou gerado
  signedDocumentUrl String?      @db.Text // PDF final com as assinaturas e carimbo jurídico
  signatureProvider String?      @default("ZapSign") // ZapSign, Clicksign, Autentique
  externalDocToken  String?      // Token/ID do documento retornado pela API
  signUrl           String?      @db.Text // Link direto caso queira copiar e mandar no WhatsApp
  signerEmail       String?      // E-mail para onde foi disparada a assinatura
  signatureStatus   String?      @default("Pendente") // Pendente, Assinado, Recusado

  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id])
  tenantId          String?      
  tenant            Tenant?      @relation(fields: [tenantId], references: [id])
  
  invoices          Invoice[]
  inspections       Inspection[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// VISTORIAS DIGITAIS (NOVO)
// ==========================================
model Inspection {
  id           String   @id @default(uuid())
  type         String   // "Entrada", "Saída", "Rotina"
  date         DateTime
  reportUrl    String?  @db.Text // Link do PDF do Laudo com fotos
  
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

// ==========================================
// FINANCEIRO / FATURAS (NOVO)
// ==========================================
model Invoice {
  id             String   @id @default(uuid())
  dueDate        DateTime
  paidDate       DateTime?
  status         String   @default("Pendente") // Pendente, Pago, Vencido
  
  // Valores
  totalAmount    Float
  realEstateFee  Float    // Parte da Imobiliária (Comissão/Taxa Admin)
  ownerAmount    Float    // Repasse ao Proprietário
  
  // Gateway de Pagamento
  barcode        String?
  pixQrCodeUrl   String?  @db.Text
  
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}