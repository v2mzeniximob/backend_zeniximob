generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS MASTER DA PLATAFORMA
// ==========================================
model MasterAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PLANOS DE ASSINATURA
// ==========================================
model Plan {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  modules      Json         // Array de módulos permitidos (ex: ["FINANCEIRO", "CRM"])
  hasSupport   Boolean      @default(false)
  supportPrice Decimal?     @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  
  realEstates  RealEstate[] // Relacionamento com as imobiliárias

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// FRANQUEADOS
// ==========================================
model Franchisee {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String       // Razão Social
  tradeName         String       // Nome Fantasia
  stateRegistration String?      // Inscrição Estadual
  cityRegistration  String?      // Inscrição Municipal
  cep               String
  address           String       // Endereço Completo
  phone             String
  
  // Dados do Responsável
  respName          String
  respCpf           String
  respAddress       String
  respPhone         String
  
  // Acesso à plataforma
  email             String       @unique
  password          String
  contractUrl       String?      // Link do PDF do contrato no Storage (S3/Cloudinary)
  isActive          Boolean      @default(true)

  realEstates       RealEstate[] // Lojas vinculadas a este franqueado

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// IMOBILIÁRIAS (LOJAS)
// ==========================================
model RealEstate {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String
  tradeName         String
  slug              String       @unique 
  stateRegistration String
  cityRegistration  String
  cep               String
  address           String
  phone             String
  respName          String
  respCpf           String
  respPhone         String
  respAddress       String
  email             String       @unique
  password          String
  contractUrl       String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  logoUrl         String?   // Logótipo da imobiliária
  heroImageUrl    String?   // Imagem de fundo gigante para a barra de pesquisa
  aboutText       String?   // Texto para a página "Sobre nós"
  footerText      String?   // Texto curto para o rodapé
  instagramUrl    String?   // Link do Instagram
  facebookUrl     String?   // Link do Facebook
  whatsappDisplay String?   // WhatsApp público para o site
  saleProposalTemplate    String?  @db.Text
  rentProposalTemplate    String?  @db.Text
  keyTermTemplate         String?  @db.Text

  planId            String
  plan              Plan         @relation(fields: [planId], references: [id])
  
  franchiseeId      String?
  franchisee        Franchisee?  @relation(fields: [franchiseeId], references: [id])

  ownerContractTemplate   String? @db.Text // Molde do contrato de Gestão (Proprietário)
  tenantContractTemplate  String? @db.Text // Molde do contrato de Locação (Inquilino)

  mpAccessToken   String? @db.Text // Token de Acesso Privado
  mpPublicKey     String? @db.Text // Chave Pública

  properties        Property[]
  leads             Lead[]
  brokers           Broker[]
  clients           Client[]     // Relacionamento unificado com Clientes
  owners            Owner[]      
  proposals         Proposal[]   // Relação adicionada
  keyTerms          KeyTerm[]    // Relação adicionada
}

// ==========================================
// CORRETORES (Equipa da Loja)
// ==========================================
model Broker {
  id               String     @id @default(uuid())
  name             String
  cpf              String     @unique
  creci            String
  phone            String
  email            String     @unique
  password         String
  isActive         Boolean    @default(true)
  profileImageUrl  String?    @db.Text
  creciDocumentUrl String?    @db.Text
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  properties   Property[]
  leads        Lead[]
  visits       Visit[]    
  clients      Client[]   

  proposals Proposal[]
  keyTerms  KeyTerm[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// PROPRIETÁRIOS
// ==========================================
model Owner {
  id                    String     @id @default(uuid())
  name                  String
  cpfOrCnpj             String
  email                 String?
  phone                 String?
  bankData              String?    @db.Text // Dados bancários para repasse financeiro
  password              String?    // Acesso ao Portal do Proprietário
  isActive              Boolean    @default(true)
  managementContractUrl String?    @db.Text
  contractToken         String?    

  realEstateId          String
  realEstate            RealEstate @relation(fields: [realEstateId], references: [id])
  properties            Property[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("owners")
}

// ==========================================
// IMÓVEIS
// ==========================================
model Property {
  id            String      @id @default(uuid())
  title         String
  type          String      // Casa, Apartamento, Terreno, etc.
  category      String      // Residencial ou Comercial
  transaction   String      // Venda ou Aluguel
  
  // Valores
  price         Float
  condoFee      Float?      @default(0) // Valor do Condomínio
  iptu          Float?      @default(0) // Valor do IPTU Mensal/Anual
  
  // Detalhes Físicos
  area          Float
  bedrooms      Int         @default(0)
  bathrooms     Int         @default(0)
  garage        Int         @default(0)
  yearBuilt     Int?        // Ano de construção
  amenities     String[]    // Array com as características
  
  // Localização Detalhada
  cep           String
  address       String
  neighborhood  String?     
  city          String?     
  state         String?     
  latitude      Float?      
  longitude     Float?      
  
  // Mídia e Status
  description   String?
  imageUrls     String[]    
  isActive      Boolean     @default(true)
  
  // Relacionamentos
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  ownerId       String?     
  owner         Owner?      @relation(fields: [ownerId], references: [id])

  rentStatus      String?   @default("Vago") // "Vago", "Alugado", "Vendido"
  inspectionUrl   String?   // Upload do Documento de Vistoria
  contractUrl     String?   // Upload do Contrato de Aluguel
  rentProposalUrl String?   // Link da Proposta de Aluguel anexada no imóvel
  saleProposalUrl String?   // Link da Proposta de Venda anexada no imóvel
  keyTermUrl      String?   // Link do Termo de Chaves anexado no imóvel
  isHighlighted   Boolean   @default(false)

  tenantId        String?
  tenant          Client?   @relation(fields: [tenantId], references: [id])
  
  leads           Lead[]
  visits          Visit[]     
  contracts       Contract[]  

  proposals Proposal[]
  keyTerms  KeyTerm[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// CLIENTES (CRM UNIFICADO - Antigo Inquilinos)
// ==========================================
model Client {
  id                String      @id @default(uuid())
  
  // Controle de Tipo
  clientType        String      @default("PF") // "PF" ou "PJ"
  
  // Dados Principais (Comuns)
  name              String      // Nome (PF) ou Nome Fantasia (PJ)
  corporateName     String?     // Razão Social (PJ)
  document          String      @unique // CPF ou CNPJ
  rg                String?     // RG (PF)
  stateRegistration String?     // Inscrição Estadual (PJ)
  cityRegistration  String?     // Inscrição Municipal (PJ)
  
  // Endereço do Cliente
  cep               String?
  street            String?
  neighborhood      String?
  city              String?
  state             String?
  
  // Contatos
  phone             String
  email             String?
  
  // Dados do Cônjuge (PF)
  maritalStatus     String?
  spouseName        String?
  spouseCpf         String?
  spouseRg          String?
  
  // Dados do Responsável (PJ)
  respName          String?
  respCpf           String?
  respRg            String?
  respCep           String?
  respStreet        String?
  respNeighborhood  String?
  respCity          String?
  respState         String?
  respPhone         String?
  respEmail         String?

  // Fiador (Caso o cliente seja/venha a ser um Inquilino)
  guarantorName     String?
  guarantorCpf      String?
  guarantorDocUrl   String?
  
  // Tags/Roles na plataforma (Definido no momento do cadastro ou edição)
  isTenant          Boolean     @default(false)
  isBuyer           Boolean     @default(false)
  isActive          Boolean     @default(true)

  // Arquivos
  documentUrl       String?
  spouseDocUrl      String?

  // Relações
  realEstateId      String
  realEstate        RealEstate  @relation(fields: [realEstateId], references: [id])
  
  brokerId          String?     // Corretor que trouxe/atende o cliente
  broker            Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  
  properties        Property[]  // Imóveis onde este cliente é inquilino
  contracts         Contract[]  // Contratos vinculados a este cliente

  proposals Proposal[]
  keyTerms  KeyTerm[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("clients")
}

// ==========================================
// LEADS (CRM)
// ==========================================
model Lead {
  id          String      @id @default(uuid())
  name        String
  phone       String
  email       String?
  interest    String      // Ex: "Comprador", "Inquilino", "Venda", etc.
  status      String      @default("Novo") // Novo, Em Atendimento, Em Proposta, Fechado, Perdido
  notes       String?
  
  stage       String      @default("Novo") 
  
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId    String?
  broker      Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  history     LeadHistory[] 

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// HISTÓRICO DE ATENDIMENTO DO LEAD
model LeadHistory {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType  String   // "WhatsApp", "Ligação", "E-mail", "Visita", "Anotação"
  description String   @db.Text
  date        DateTime @default(now())
}

// ==========================================
// CONTROLE DE VISITAS
// ==========================================
model Visit {
  id          String   @id @default(uuid())
  date        DateTime
  status      String   @default("Agendada") // Agendada, Realizada, Cancelada
  feedback    String?  @db.Text
  
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  brokerId    String
  broker      Broker   @relation(fields: [brokerId], references: [id])
  
  createdAt   DateTime @default(now())
}

// ==========================================
// CONTRATOS
// ==========================================
model Contract {
  id                String       @id @default(uuid())
  type              String       // "Locação", "Venda"
  status            String       @default("Ativo")
  
  startDate         DateTime
  endDate           DateTime?
  
  rentValue         Float      
  adminFeePercent   Float      
  readjustmentIndex String?     
  
  documentUrl       String?      @db.Text // PDF anexado após assinatura

  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id])
  
  tenantId          String?      
  tenant            Client?      @relation(fields: [tenantId], references: [id])
  
  invoices          Invoice[]
  inspections       Inspection[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// VISTORIAS DIGITAIS
// ==========================================
model Inspection {
  id         String   @id @default(uuid())
  type       String   // "Entrada", "Saída", "Rotina"
  date       DateTime
  reportUrl  String?  @db.Text // Link do PDF do Laudo com fotos
  
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

// ==========================================
// FINANCEIRO / FATURAS
// ==========================================
model Invoice {
  id             String   @id @default(uuid())
  dueDate        DateTime
  paidDate       DateTime?
  status         String   @default("Pendente") // Pendente, Pago, Vencido
  
  // Valores
  totalAmount    Float
  realEstateFee  Float    // Parte da Imobiliária (Comissão/Taxa Admin)
  ownerAmount    Float    // Repasse ao Proprietário
  
  // Gateway de Pagamento
  barcode        String?
  pixQrCodeUrl   String?  @db.Text
  
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id])

  mpPaymentId      String?  // ID do pagamento no Mercado Pago
  pixQrCode        String?  @db.Text // O código Copia e Cola do PIX
  pixQrCodeBase64  String?  @db.Text // A imagem do QR Code em Base64
  ticketUrl        String?  @db.Text // Link para o PDF do boleto/comprovante
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// PROPOSTAS
// ==========================================
model Proposal {
  id           String   @id @default(uuid())
  type         String   // "Venda" ou "Locação"
  status       String   @default("Pendente") // Pendente, Aceita, Recusada
  documentUrl  String?
  propertyId   String
  clientId     String
  brokerId     String?
  realEstateId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property     Property   @relation(fields: [propertyId], references: [id])
  client       Client     @relation(fields: [clientId], references: [id])
  broker       Broker?    @relation(fields: [brokerId], references: [id])
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id])
}

// ==========================================
// TERMOS DE CHAVES
// ==========================================
model KeyTerm {
  id           String   @id @default(uuid())
  type         String   // "Venda" ou "Locação"
  status       String   @default("Pendente") // Pendente, Assinado
  documentUrl  String?
  propertyId   String
  clientId     String
  brokerId     String?
  realEstateId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property     Property   @relation(fields: [propertyId], references: [id])
  client       Client     @relation(fields: [clientId], references: [id])
  broker       Broker?    @relation(fields: [brokerId], references: [id])
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id])
}