generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS MASTER DA PLATAFORMA
// ==========================================
model MasterAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PLANOS DE ASSINATURA
// ==========================================
model Plan {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  modules      Json         // Array de módulos permitidos (ex: ["FINANCEIRO", "CRM"])
  hasSupport   Boolean      @default(false)
  supportPrice Decimal?     @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  
  realEstates  RealEstate[] // Relacionamento com as imobiliárias

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// FRANQUEADOS
// ==========================================
model Franchisee {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String       // Razão Social
  tradeName         String       // Nome Fantasia
  stateRegistration String?      // Inscrição Estadual
  cityRegistration  String?      // Inscrição Municipal
  cep               String
  address           String       // Endereço Completo
  phone             String
  
  // Dados do Responsável
  respName          String
  respCpf           String
  respAddress       String
  respPhone         String
  
  // Acesso à plataforma
  email             String       @unique
  password          String
  contractUrl       String?      // Link do PDF do contrato no Storage (S3/Cloudinary)
  isActive          Boolean      @default(true)

  realEstates       RealEstate[] // Lojas vinculadas a este franqueado

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// IMOBILIÁRIAS (LOJAS)
// ==========================================
model RealEstate {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String
  tradeName         String
  slug              String       @unique 
  stateRegistration String
  cityRegistration  String
  cep               String
  address           String
  phone             String
  respName          String
  respCpf           String
  respPhone         String
  respAddress       String
  email             String       @unique
  password          String
  contractUrl       String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  logoUrl         String?   // Logótipo da imobiliária
  heroImageUrl    String?   // Imagem de fundo gigante para a barra de pesquisa
  aboutText       String?   // Texto para a página "Sobre nós"
  footerText      String?   // Texto curto para o rodapé
  instagramUrl    String?   // Link do Instagram
  facebookUrl     String?   // Link do Facebook
  whatsappDisplay String?   // WhatsApp público para o site

  planId            String
  plan              Plan         @relation(fields: [planId], references: [id])
  
  franchiseeId      String?
  franchisee        Franchisee?  @relation(fields: [franchiseeId], references: [id])

  properties        Property[]
  leads             Lead[]
  brokers           Broker[]
  tenants Tenant[]
}

// ==========================================
// CORRETORES (Equipa da Loja)
// ==========================================
model Broker {
  id           String     @id @default(uuid())
  name         String
  cpf          String     @unique
  creci        String
  phone        String
  email        String     @unique
  password     String
  isActive     Boolean    @default(true)
  profileImageUrl String? @db.Text
  creciDocumentUrl String? @db.Text
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  // ATUALIZAÇÃO: Relações com Imóveis e Leads
  properties   Property[]
  leads        Lead[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// IMÓVEIS (ATUALIZADO PARA PÁGINA DETALHADA)
// ==========================================
model Property {
  id            String      @id @default(uuid())
  title         String
  type          String      // Casa, Apartamento, Terreno, etc.
  category      String      // Residencial ou Comercial
  transaction   String      // Venda ou Aluguel
  
  // Valores
  price         Float
  condoFee      Float?      @default(0) // Valor do Condomínio
  iptu          Float?      @default(0) // Valor do IPTU Mensal/Anual
  
  // Detalhes Físicos
  area          Float
  bedrooms      Int         @default(0)
  bathrooms     Int         @default(0)
  garage        Int         @default(0)
  yearBuilt     Int?        // Ano de construção
  amenities     String[]    // Array com as características (ex: ["Piscina", "Academia", "Churrasqueira"])
  
  // Localização Detalhada
  cep           String
  address       String
  neighborhood  String?     // Bairro (Usado para o mapa focar apenas na região)
  city          String?     // Cidade
  state         String?     // Estado (UF)
  latitude      Float?      // Coordenada Y (Opcional, preenchido via API de CEP no front)
  longitude     Float?      // Coordenada X (Opcional)
  
  // Mídia e Status
  description   String?
  imageUrls     String[]    // Array com as URLs das fotos
  isActive      Boolean     @default(true)
  
  // Relacionamentos
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  rentStatus      String?   @default("Vago") // "Vago" ou "Alugado"
  inspectionUrl   String?   // Upload do Documento de Vistoria
  contractUrl     String?   // Upload do Contrato de Aluguel
  isHighlighted   Boolean   @default(false)

  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  leads         Lead[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// LEADS (CRM)
// ==========================================
model Lead {
  id            String      @id @default(uuid())
  name          String
  phone         String
  email         String?
  interest      String      // Comprar, Alugar, etc.
  status        String      @default("Novo") // Novo, Em Atendimento, Em Proposta, Fechado, Perdido
  notes         String?
  
  propertyId    String?
  property      Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  // ATUALIZAÇÃO: Vinculação ao Corretor que está atendendo
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Tenant {
  id              String      @id @default(uuid())
  
  // Dados do Inquilino
  name            String
  cpf             String      @unique
  currentAddress  String
  phone           String
  email           String
  documentUrl     String?     // Upload do documento do inquilino
  maritalStatus   String      // "Solteiro", "Casado", "Divorciado", etc.
  
  // Dados do Cônjuge (Se casado)
  spouseName      String?
  spouseCpf       String?
  spouseDocUrl    String?     // Upload do documento do cônjuge
  
  // Dados do Fiador
  guarantorName   String?
  guarantorCpf    String?
  guarantorDocUrl String?     // Upload do documento do fiador
  
  // Controle do sistema
  isActive        Boolean     @default(true)
  
  // Relações
  realEstateId    String
  realEstate      RealEstate  @relation(fields: [realEstateId], references: [id])
  properties      Property[]  // Imóveis que este inquilino alugou
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("tenants")
}