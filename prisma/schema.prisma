generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS MASTER DA PLATAFORMA
// ==========================================
model MasterAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PLANOS DE ASSINATURA
// ==========================================
model Plan {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  modules      Json         // Array de módulos permitidos (ex: ["FINANCEIRO", "CRM"])
  hasSupport   Boolean      @default(false)
  supportPrice Decimal?     @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  
  realEstates  RealEstate[] // Relacionamento com as imobiliárias

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// FRANQUEADOS
// ==========================================
model Franchisee {
  id                String           @id @default(uuid())
  cnpj              String           @unique
  corporateName     String           // Razão Social
  tradeName         String           // Nome Fantasia
  stateRegistration String?          // Inscrição Estadual
  cityRegistration  String?          // Inscrição Municipal
  cep               String
  address           String           // Endereço Completo
  phone             String
  
  // Dados do Responsável
  respName          String
  respCpf           String
  respAddress       String
  respPhone         String
  
  // Acesso à plataforma
  email             String           @unique
  password          String
  contractUrl       String?          // Link do PDF do contrato no Storage (S3/Cloudinary)
  isActive          Boolean          @default(true)

  realEstates       RealEstate[]     // Lojas vinculadas a este franqueado

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  masterContracts   MasterContract[]
}

// ==========================================
// IMOBILIÁRIAS (LOJAS)
// ==========================================
model RealEstate {
  id                     String   @id @default(uuid())
  cnpj                   String   @unique
  corporateName          String
  tradeName              String
  slug                   String   @unique 
  stateRegistration      String
  cityRegistration       String
  cep                    String
  address                String
  phone                  String
  respName               String
  respCpf                String
  respPhone              String
  respAddress            String
  email                  String   @unique
  password               String
  contractUrl            String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  logoUrl                String?  // Logótipo da imobiliária
  heroImageUrl           String?  // Imagem de fundo gigante para a barra de pesquisa
  aboutText              String?  // Texto para a página "Sobre nós"
  footerText             String?  // Texto curto para o rodapé
  instagramUrl           String?  // Link do Instagram
  facebookUrl            String?  // Link do Facebook
  whatsappDisplay        String?  // WhatsApp público para o site
  saleProposalTemplate   String?  @db.Text
  rentProposalTemplate   String?  @db.Text
  keyTermTemplate        String?  @db.Text
  financingTemplate      String?  @db.Text // Molde do Checklist de Financiamento

  planId                 String
  plan                   Plan     @relation(fields: [planId], references: [id])
  
  franchiseeId           String?
  franchisee             Franchisee? @relation(fields: [franchiseeId], references: [id])

  ownerContractTemplate  String?  @db.Text // Molde do contrato de Gestão (Proprietário)
  tenantContractTemplate String?  @db.Text // Molde do contrato de Locação (Inquilino)
  saleContractTemplate   String?  @db.Text // Molde do contrato de Compra e Venda

  mpAccessToken          String?  @db.Text // Token de Acesso Privado
  mpPublicKey            String?  @db.Text // Chave Pública
  subscriptionStatus     String   @default("Ativo") // Ativo, Inadimplente, Bloqueado
  paymentGatewayId       String?  // ID do cliente no Asaas/Stripe

  // CONFIGURAÇÕES FISCAIS (FOCUS NFE & CERTIFICADO A1)

  focusNfeToken          String?  @db.Text // Token da API Focus NFe da Imobiliária
  focusEnv               String?  @default("homologacao") // "homologacao" ou "producao"
  a1CertPath             String?  @db.Text // Caminho do arquivo .pfx (Certificado A1)
  a1CertPassword         String?  // Senha do Certificado Digital A1
  a1CertExpiresAt        DateTime? // Data de validade do Certificado A1
  taxRegime              String?  @default("Simples Nacional") // Simples Nacional, Lucro Presumido, Lucro Real

  whatsappConfig         WhatsappConfig?

  rouletteEnabled        Boolean  @default(false)
  rouletteTimeoutMinutes Int      @default(30) // Tempo em minutos para repescagem
  agencySplitPercent     Float    @default(50) // % padrão da Imobiliária
  sellerSplitPercent     Float    @default(35) // % padrão do Corretor Vendedor
  captatorSplitPercent   Float    @default(10) // % padrão do Corretor Captador
  managerSplitPercent    Float    @default(5)  // % padrão do Gerente

  commissions            Commission[]
  valuations             PropertyValuation[]
  properties             Property[]
  leads                  Lead[]
  brokers                Broker[]
  clients                Client[]   
  owners                 Owner[]      
  proposals              Proposal[]   
  keyTerms               KeyTerm[]    
  insuranceCompanies     InsuranceCompany[] 
  keyMovements           KeyMovement[]
  masterContracts        MasterContract[]
  condominiums           Condominium[] 

  // Relacionamentos do Kanban
  pipelineStages         PipelineStage[]
  deals                  Deal[]

  // Relacionamentos do Módulo Fiscal
  taxRules               TaxRule[]
  brokerInvoices         BrokerInvoice[]

  // Relacionamentos do Módulo de Despesas
  agencyExpenses         AgencyExpense[]
  contaAzulConfig        ContaAzulConfig?

  spes                   DeveloperSpe[]
  landBanks              LandBank[]
  developmentProjects    DevelopmentProject[]
}

// ==========================================
// MÓDULO FISCAL: REGRAS E NOTAS DE REPASSE
// ==========================================
model TaxRule {
  id              String     @id @default(uuid())
  realEstateId    String
  realEstate      RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  name            String     // Ex: "Taxa de Administração de Aluguel", "Corretagem de Venda", "Repasse Corretor"
  operationType   String     @default("AMBOS") // "LOCACAO_ADMIN", "VENDA_CORRETAGEM", "REPASSE_CORRETOR", "AMBOS"
  serviceCode     String     // Código de serviço municipal (LC 116 - ex: "10.05")
  cnaeCode        String?    // CNAE correspondente (ex: "6821801", "6821802")

  issRate         Decimal    @default(2.00) @db.Decimal(5, 2) // % ISS
  pisRate         Decimal    @default(0.65) @db.Decimal(5, 2) // % PIS
  cofinsRate      Decimal    @default(3.00) @db.Decimal(5, 2) // % COFINS
  csllRate        Decimal    @default(1.00) @db.Decimal(5, 2) // % CSLL
  irRate          Decimal    @default(1.50) @db.Decimal(5, 2) // % IRRF
  inssRate        Decimal    @default(0.00) @db.Decimal(5, 2) // % INSS
  retainIss       Boolean    @default(false) // Retenção de ISS na fonte

  // Reforma Tributária (Lei Complementar nº 214/2025 - Vigência 01/12/2026)
  applyIbsCbs     Boolean    @default(false)
  ibsRate         Decimal?   @default(0.00) @db.Decimal(5, 2) // % IBS
  cbsRate         Decimal?   @default(0.00) @db.Decimal(5, 2) // % CBS

  isActive        Boolean    @default(true)

  brokers         Broker[]
  brokerInvoices  BrokerInvoice[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model BrokerInvoice {
  id               String     @id @default(uuid())
  realEstateId     String
  realEstate       RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  brokerId         String
  broker           Broker     @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  taxRuleId        String?
  taxRule          TaxRule?   @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)

  commissionId     String?    // Vínculo opcional com o registro de comissão gerada no rateio
  amount           Decimal    @db.Decimal(10, 2) // Valor do repasse/comissão
  description      String?    @db.Text           // Discriminação do serviço na NFS-e

  status           String     @default("PENDING") // "PENDING", "PROCESSING", "ISSUED", "CANCELLED", "ERROR"
  focusRef         String?    @unique             // Referência única enviada à Focus NFe
  nfseNumber       String?                        // Número da NFS-e gerada na prefeitura
  verificationCode String?                        // Código de verificação da NFS-e
  pdfUrl           String?    @db.Text            // URL do PDF da Nota Fiscal
  xmlUrl           String?    @db.Text            // URL do XML da Nota Fiscal
  errorMessage     String?    @db.Text            // Mensagem de rejeição/erro caso ocorra
  issuedAt         DateTime?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ==========================================
// ESTEIRA DE VENDAS E LOCAÇÃO (KANBAN)
// ==========================================
model PipelineStage {
  id           String     @id @default(uuid())
  name         String
  orderIndex   Int
  colorCode    String     @default("#94A3B8")
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  deals        Deal[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Deal {
  id              String        @id @default(uuid())
  title           String        // Ex: "Compra - Apto Tatuapé"
  transactionType String        // "Venda" ou "Locação"
  status          String        @default("IN_PROGRESS") // IN_PROGRESS, WON, LOST
  agreedPrice     Float?
  
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id])
  
  brokerId        String
  broker          Broker        @relation(fields: [brokerId], references: [id])

  realEstateId    String
  realEstate      RealEstate    @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  history         DealHistory[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DealHistory {
  id         String   @id @default(uuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorName String?  // Nome de quem escreveu
  note       String   @db.Text // Texto da observação
  createdAt  DateTime @default(now())
}

// ==========================================
// CONDOMÍNIOS & ADMINISTRAÇÃO CONDOMINIAL
// ==========================================
model Condominium {
  id               String     @id @default(uuid())
  cnpj             String?
  name             String     // Razão Social / Nome do condomínio
  
  // Endereço
  cep              String?
  address          String?    // Logradouro, número, complemento
  neighborhood     String?
  city             String?
  state            String?
  
  type             String?    // Horizontal (casas) ou Vertical (prédios)
  
  // Administração
  adminName        String?    // Nome da administradora
  managerName      String?    // Síndico atual
  email            String?    // E-mail de contato
  phone            String?    // Telefone de contato
  
  // Detalhes Técnicos e Vagas
  towerOrBlock     String?    // Torre, bloco ou quadra
  privateArea      Float?     // Fração ideal / Área privativa (m²)
  hasGarage        Boolean    @default(false)
  hasCoveredGarage Boolean    @default(false)
  
  isActive         Boolean    @default(true)
  
  // Relacionamentos
  realEstateId     String
  realEstate       RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  properties       Property[] // Imóveis vinculados a este condomínio
  units            CondoUnit[]
  expenses         CondoExpense[]
  reservations     CondoReservation[]
  occurrences      CondoOccurrence[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("condominiums")
}

model CondoUnit {
  id            String      @id @default(uuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  unitNumber    String      // Ex: "Apt 101", "Casa 12"
  block         String?     // Torre ou Bloco
  floor         Int?        // Andar
  fractionIdeal Float       @default(1.0) // Fração ideal para rateio
  ownerName     String?     // Nome do proprietário da unidade
  tenantName    String?     // Nome do inquilino da unidade
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CondoExpense {
  id            String      @id @default(uuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  description   String      // Ex: "Conta de Água da Área Comum", "Manutenção do Portão"
  amount        Float       // Valor total da despesa
  dueDate       DateTime    // Vencimento do rateio
  category      String      @default("Manutenção") // Manutenção, Água, Limpeza, Fundo de Reserva
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CondoReservation {
  id              String      @id @default(uuid())
  condominiumId   String
  condominium     Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  areaName        String      // Ex: "Salão de Festas", "Churrasqueira", "Quadra"
  reservedBy      String      // Nome do condômino/morador
  reservationDate DateTime    // Data da reserva
  status          String      @default("CONFIRMED") // CONFIRMED, CANCELLED
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CondoOccurrence {
  id            String      @id @default(uuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  title         String      // Assunto da ocorrência
  description   String      @db.Text // Descrição detalhada
  reportedBy    String      // Quem reportou
  priority      String      @default("Normal") // Baixa, Normal, Urgente
  status        String      @default("Aberto") // Aberto, Em Análise, Resolvido
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// SEGURADORAS (Seguro Fiança)
// ==========================================
model InsuranceCompany {
  id           String     @id @default(uuid())
  name         String
  cnpj         String?
  contactInfo  String?
  isActive     Boolean    @default(true)
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  clients      Client[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// CORRETORES (Equipa da Loja)
// ==========================================
model Broker {
  id                 String     @id @default(uuid())
  name               String
  cpf                String     @unique
  cnpj               String?    // Caso o corretor atue como PJ / MEI para emissão/recebimento de NFS-e
  creci              String
  phone              String
  email              String     @unique
  password           String
  isActive           Boolean    @default(true)
  profileImageUrl    String?    @db.Text
  creciDocumentUrl   String?    @db.Text

  saleCommission     Float?     @default(0) // Porcentagem de comissão em Vendas
  rentCommission     Float?     @default(0) // Porcentagem de comissão em Locação
  
  realEstateId       String
  realEstate         RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  role               String     @default("Corretor") // "Corretor", "Captador", "Gerente"
  captureCommission  Float?     @default(10) // % quando ele é o Captador do imóvel
  managerCommission  Float?     @default(5)  // % de Gerência sobre negócios da equipe
  
  // Vínculo com Regra Fiscal para emissão de nota de repasse
  taxRuleId          String?
  taxRule            TaxRule?   @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  brokerInvoices     BrokerInvoice[]

  // Controle da Roleta de Leads
  inRoulette         Boolean    @default(true)
  lastLeadAssignedAt DateTime?  // Controla quem é o próximo da fila circular

  commissions        Commission[]
  
  // Relacionamentos ajustados com nomes específicos
  properties         Property[] @relation("PropertyBroker")
  capturedProperties Property[] @relation("PropertyCaptator") // Imóveis que ele angariou

  leads              Lead[]
  visits             Visit[]    
  clients            Client[]   

  proposals          Proposal[]
  keyTerms           KeyTerm[]
  keyMovements       KeyMovement[]

  // Relacionamento com Negócios (Kanban)
  deals              Deal[]

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

// ==========================================
// PROPRIETÁRIOS
// ==========================================
model Owner {
  id                    String     @id @default(uuid())
  name                  String
  cpfOrCnpj             String
  personType            String     @default("PF") // "PF" ou "PJ" (PJ emite nota sobre valor integral do aluguel)
  ibsCbsContributor     Boolean    @default(false) // PF contribuinte IBS/CBS (> 3 imóveis locados e receita > R$ 240 mil/ano - LC 214/2025)
  email                 String?
  phone                 String?
  bankData              String?    @db.Text // Dados bancários para repasse financeiro
  password              String?    // Acesso ao Portal do Proprietário
  isActive              Boolean    @default(true)
  managementContractUrl String?    @db.Text
  contractToken         String?    
  inspectionUrl         String?    @db.Text 

  realEstateId          String
  realEstate            RealEstate @relation(fields: [realEstateId], references: [id])
  properties            Property[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("owners")
}

// ==========================================
// IMÓVEIS
// ==========================================
model Property {
  id                String          @id @default(uuid())
  title             String
  type              String          // Casa, Apartamento, Terreno, etc.
  category          String          // Residencial ou Comercial
  transaction       String          // Venda ou Aluguel
  code              String?
  // Valores
  price             Float
  condoFee          Float?          @default(0) // Valor do Condomínio
  iptu              Float?          @default(0) // Valor do IPTU Mensal/Anual
  
  // Detalhes Físicos
  area              Float
  bedrooms          Int             @default(0)
  bathrooms         Int             @default(0)
  garage            Int             @default(0)
  yearBuilt         Int?            // Ano de construção
  amenities         String[]        // Array com as características
  
  // Localização Detalhada
  cep               String
  address           String
  neighborhood      String?      
  city              String?      
  state             String?      
  latitude          Float?      
  longitude         Float?
  iptuRegistration  String?         // Inscrição Imobiliária (IPTU)
  
  // Mídia e Status
  description       String?
  imageUrls         String[]    
  videoUrl          String?         // Link do YouTube/Vimeo
  tour360Url        String?         // Link do Tour Virtual (Matterport, etc)
  isActive          Boolean         @default(true)
  exportToPortals   Boolean         @default(false) // Flag para enviar para Zap/VivaReal
  tickets           Ticket[]        // Relacionamento
  
  // Condições de Negociação
  acceptsFinancing  Boolean         @default(false)
  acceptsExchange   Boolean         @default(false)
  exchangeDetails   String?         @db.Text
  
  // Captação
  exclusive         Boolean         @default(false)
  exclusiveUntil    DateTime?

  // Relacionamentos
  realEstateId      String
  realEstate        RealEstate      @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId          String?
  broker            Broker?         @relation("PropertyBroker", fields: [brokerId], references: [id], onDelete: SetNull)

  // Corretor que Angariou (Captador)
  captatorId        String?
  captator          Broker?         @relation("PropertyCaptator", fields: [captatorId], references: [id], onDelete: SetNull)

  ownerId           String?     
  owner             Owner?          @relation(fields: [ownerId], references: [id])

  condominiumId     String?
  condominium       Condominium?    @relation(fields: [condominiumId], references: [id], onDelete: SetNull)

  rentStatus        String?         @default("Vago") // "Vago", "Alugado", "Vendido"
  inspectionUrl     String?         // Upload do Documento de Vistoria
  contractUrl       String?         // Upload do Contrato de Aluguel
  rentProposalUrl   String?         // Link da Proposta de Aluguel anexada no imóvel
  saleProposalUrl   String?         // Link da Proposta de Venda anexada no imóvel
  keyTermUrl        String?         // Link do Termo de Chaves anexado no imóvel
  isHighlighted     Boolean         @default(false)

  tenantId          String?
  tenant            Client?         @relation(fields: [tenantId], references: [id])

  keyCode           String?         // Ex: "Gaveta 14", "A-12"
  keyStatus         String          @default("Disponível") // "Disponível", "Retirada", "Indisponível"
  qrCodeHash        String?         @unique // Hash de segurança único para imprimir no QR Code da chave
  
  icalExportToken   String?         @default(uuid()) // Token único para a URL pública iCal deste imóvel
  airbnbIcalUrl     String?         @db.Text         // Link iCal gerado no Airbnb
  bookingIcalUrl    String?         @db.Text         // Link iCal gerado no Booking.com
  vrboIcalUrl       String?         @db.Text         // Link iCal gerado no VRBO/outros
  lastIcalSyncAt    DateTime?
  
  seasonBookings    SeasonBooking[]
  keyMovements      KeyMovement[]
  leads             Lead[]
  visits            Visit[]     
  contracts         Contract[]  
  proposals         Proposal[]
  keyTerms          KeyTerm[]
  deals             Deal[]

  // Relações do Módulo de Despesas
  propertyExpenses  PropertyExpense[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ==========================================
// CLIENTES (CRM UNIFICADO - Antigo Inquilinos)
// ==========================================
model Client {
  id                           String            @id @default(uuid())
  
  // Controle de Tipo
  clientType                   String            @default("PF") // "PF" ou "PJ"
  
  // Dados Principais (Comuns)
  name                         String            // Nome (PF) ou Nome Fantasia (PJ)
  corporateName                String?           // Razão Social (PJ)
  document                     String            @unique // CPF ou CNPJ
  rg                           String?           // RG (PF)
  stateRegistration            String?           // Inscrição Estadual (PJ)
  cityRegistration             String?           // Inscrição Municipal (PJ)
  
  // Endereço do Cliente
  cep                          String?
  street                       String?
  neighborhood                 String?
  city                         String?
  state                        String?
  
  // Contatos
  phone                        String
  email                        String?
  password                     String?           // Senha para acessar o Portal do Inquilino
  tickets                      Ticket[]          // Relacionamento com os chamados de manutenção
  
  // Dados do Cônjuge (PF)
  maritalStatus                String?
  spouseName                   String?
  spouseCpf                    String?
  spouseRg                     String?
  
  // Dados do Responsável (PJ)
  respName                     String?
  respCpf                      String?
  respRg                       String?
  respCep                      String?
  respStreet                   String?
  respNeighborhood             String?
  respCity                     String?
  respState                    String?
  respPhone                    String?
  respEmail                    String?

  // GARANTIAS LOCATÍCIAS E DADOS ROBUSTOS DO FIADOR
  guaranteeType                String?           // "Avalista", "Fiador", "Seguro Fiança"
  insuranceCompanyId           String?
  insuranceCompany             InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  
  guarantorName                String?
  guarantorCpf                 String?
  guarantorRg                  String?
  guarantorCivilStatus         String?
  guarantorPhone               String?
  guarantorEmail               String?
  guarantorAddress             String?
  guarantorIncome              Float?
  guarantorDocUrl              String?           // Documentos pessoais do Fiador/Avalista
  guarantorPropertyRegistryUrl String?           // Registro de Imóveis do Fiador/Avalista

  // CHECKLIST DE FINANCIAMENTO
  educationLevel               String?           // Select: Ensino Médio, Superior, etc.
  financingDriveLink           String?           @db.Text // Link da pasta do Drive com Holerite, FGTS, IRPF, Residencia, Certidão.
  
  // Tags/Roles na plataforma (Definido no momento do cadastro ou edição)
  isTenant                     Boolean           @default(false)
  isBuyer                      Boolean           @default(false)
  isActive                     Boolean           @default(true)

  // Arquivos
  documentUrl                  String?
  spouseDocUrl                 String?

  // Relações
  realEstateId                 String
  realEstate                   RealEstate        @relation(fields: [realEstateId], references: [id])
  
  brokerId                     String?           // Corretor que trouxe/atende o cliente
  broker                       Broker?           @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  
  properties                   Property[]        // Imóveis onde este cliente é inquilino
  contracts                    Contract[]        // Contratos vinculados a este cliente

  proposals                    Proposal[]
  keyTerms                     KeyTerm[]
  
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@map("clients")
}

// ==========================================
// LEADS E PERFIL DE BUSCA (CRM MATCHMAKING)
// ==========================================
model Lead {
  id                  String        @id @default(uuid())
  name                String
  phone               String
  email               String?
  interest            String        // Ex: "Comprador", "Inquilino", "Venda", etc.
  status              String        @default("Novo") // Novo, Em Atendimento, Em Proposta, Fechado, Perdido
  notes               String?
  
  stage               String        @default("Novo") 
  
  propertyId          String?
  property            Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  realEstateId        String
  realEstate          RealEstate    @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId            String?
  broker              Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  searchType          String?       // "Casa", "Apartamento", "Comercial", "Qualquer"
  searchTransaction   String?       // "Locação", "Venda", "Qualquer"
  searchMinPrice      Float?        // Valor mínimo que deseja pagar
  searchMaxPrice      Float?        // Valor máximo que deseja pagar
  searchNeighborhoods String[]      // Array com os bairros desejados
  searchMinBedrooms   Int?          // Número mínimo de quartos
  searchMinGarage     Int?          // Número mínimo de vagas

  // Controle de Repescagem Automática (SLA de Atendimento)
  assignedAt          DateTime?     @default(now()) // Hora exata em que o corretor recebeu o lead
  firstContactAt      DateTime?     // Preenchido quando o corretor interage (trava a repescagem)
  reassignedCount     Int           @default(0)     // Quantas vezes o lead mudou de corretor por atraso

  history             LeadHistory[] 
  
  // Relacionamento com Negócios (Kanban)
  deals               Deal[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// HISTÓRICO DE ATENDIMENTO DO LEAD
model LeadHistory {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType  String   // "WhatsApp", "Ligação", "E-mail", "Visita", "Anotação"
  description String   @db.Text
  date        DateTime @default(now())
}

// ==========================================
// CONTROLE DE VISITAS
// ==========================================
model Visit {
  id         String   @id @default(uuid())
  date       DateTime
  status     String   @default("Agendada") // Agendada, Realizada, Cancelada
  feedback   String?  @db.Text
  
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  brokerId   String
  broker     Broker   @relation(fields: [brokerId], references: [id])
  
  createdAt  DateTime @default(now())
}

// ==========================================
// CONTRATOS
// ==========================================
model Contract {
  id                String       @id @default(uuid())
  type              String       // "Locação", "Venda"
  status            String       @default("Ativo")
  
  startDate         DateTime
  endDate           DateTime?
  
  rentValue         Float      
  adminFeePercent   Float      
  readjustmentIndex String?     
  
  // CAMPOS PARA O CAUÇÃO
  depositValue      Float?       @default(0) // Valor do Caução
  depositDate       DateTime?    // Data de vencimento do boleto de caução
  
  documentUrl       String?      @db.Text // PDF anexado após assinatura

  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id])
  
  tenantId          String?     
  tenant            Client?      @relation(fields: [tenantId], references: [id])
  
  invoices          Invoice[]
  inspections       Inspection[]

  // Relações do Módulo de Despesas
  propertyExpenses  PropertyExpense[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// VISTORIAS DIGITAIS
// ==========================================
model Inspection {
  id         String   @id @default(uuid())
  type       String   // "Entrada", "Saída", "Rotina"
  date       DateTime
  reportUrl  String?  @db.Text // Link do PDF do Laudo com fotos
  
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

// ==========================================
// FINANCEIRO / FATURAS
// ==========================================
model Invoice {
  id              String    @id @default(uuid())
  dueDate         DateTime
  paidDate        DateTime?
  status          String    @default("Pendente") // Pendente, Pago, Vencido
  
  // Título Dinâmico (ex: "Aluguel Mensal", "Caução")
  description     String?  
  
  // Valores da Cobrança do Inquilino
  totalAmount     Float
  
  // DETALHAMENTO DO REPASSE PARA O PROPRIETÁRIO
  realEstateFee   Float     // Parte da Imobiliária (Comissão/Taxa Admin sobre a qual a imobiliária emite NFS-e)
  ownerAmount     Float     // Repasse Base ao Proprietário (Aluguel - Taxa)
  
  iptuValue       Float?    @default(0)
  iptuDocUrl      String?   @db.Text
  
  condoValue      Float?    @default(0)
  condoDocUrl     String?   @db.Text
  
  waterValue      Float?    @default(0)
  waterDocUrl     String?   @db.Text
  
  fineValue       Float?    @default(0) // Multas (atraso, quebra)
  fineDocUrl      String?   @db.Text
  
  // Status específico para o repasse ao proprietário
  transferStatus  String    @default("Aguardando") // Aguardando, Repassado
  transferDate    DateTime? 
  
  // Controle Fiscal (NFS-e emitida sobre a Taxa de Administração - realEstateFee)
  nfseStatus      String?   // "PENDING", "ISSUED", "ERROR"
  nfseFocusRef    String?
  nfsePdfUrl      String?   @db.Text
  nfseXmlUrl      String?   @db.Text

  // Gateway de Pagamento
  barcode         String?
  pixQrCodeUrl    String?   @db.Text
  
  contractId      String
  contract        Contract  @relation(fields: [contractId], references: [id])

  mpPaymentId     String?   // ID do pagamento no Mercado Pago
  pixQrCode       String?   @db.Text // O código Copia e Cola do PIX
  pixQrCodeBase64 String?   @db.Text // A imagem do QR Code em Base64
  ticketUrl       String?   @db.Text // Link para o PDF do boleto/comprovante
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// PROPOSTAS
// ==========================================
model Proposal {
  id           String     @id @default(uuid())
  type         String     // "Venda" ou "Locação"
  status       String     @default("Pendente") // Pendente, Aceita, Recusada
  documentUrl  String?
  propertyId   String
  clientId     String
  brokerId     String?
  realEstateId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  property     Property   @relation(fields: [propertyId], references: [id])
  client       Client     @relation(fields: [clientId], references: [id])
  broker       Broker?    @relation(fields: [brokerId], references: [id])
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id])
}

// ==========================================
// MÓDULO DE MANUTENÇÕES E OBRAS (TICKETING)
// ==========================================
model Ticket {
  id          String          @id @default(uuid())
  title       String
  description String          @db.Text
  status      String          @default("Aberto") // Aberto, Em Orçamento, Em Andamento, Concluído
  priority    String          @default("Média")  // Baixa, Média, Alta
  imageUrl    String?         @db.Text           // Inquilino pode anexar foto do problema
  
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id])
  
  clientId    String?  
  client      Client?         @relation(fields: [clientId], references: [id]) // Inquilino que abriu

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages    TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  sender    String   // Vai guardar se foi 'ADMIN', 'CLIENT' ou 'OWNER'
  createdAt DateTime @default(now())
}

model KeyTerm {
  id           String       @id @default(uuid())
  type         String       // "Entrega - Locação", "Entrega - Venda", "Devolução"
  status       String       @default("Pendente") // Pendente, Assinado
  documentUrl  String?
  propertyId   String
  clientId     String
  brokerId     String?
  realEstateId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  broker       Broker?      @relation(fields: [brokerId], references: [id])
  realEstate   RealEstate   @relation(fields: [realEstateId], references: [id])

  // LIGAÇÃO: Um Termo pode gerar um registro físico de saída/entrada de chave
  keyMovement  KeyMovement?
}

model KeyMovement {
  id                  String     @id @default(uuid())
  propertyId          String
  clientName          String?   
  reason              String?    // Ex: "Visita", "Vistoria", "Manutenção"
  withdrawnAt         DateTime   @default(now())
  
  // SLA de devolução e Assinatura Digital
  expectedReturnAt    DateTime?  // Prazo limite acordado para devolução (ex: devolver em 4h)
  returnedAt          DateTime?
  digitalSignatureUrl String?    @db.Text // Assinatura feita no ecrã (Canvas)
  notes               String?

  keyTermId           String?    @unique
  keyTerm             KeyTerm?   @relation(fields: [keyTermId], references: [id])

  property            Property   @relation(fields: [propertyId], references: [id])
  brokerId            String?
  broker              Broker?    @relation(fields: [brokerId], references: [id])
  
  realEstateId        String
  realEstate          RealEstate @relation(fields: [realEstateId], references: [id])
}

// ==========================================
// CONFIGURAÇÕES GERAIS DO MASTER
// ==========================================
model MasterConfig {
  id                           String   @id @default(uuid())
  mpAccessToken                String?  @db.Text
  mpPublicKey                  String?  @db.Text
  templateMasterFranchisee     String?  @db.Text
  templateMasterRealEstate     String?  @db.Text
  templateFranchiseeRealEstate String?  @db.Text
  updatedAt                    DateTime @updatedAt
}

// ==========================================
// CONTRATOS DO MASTER (SaaS)
// ==========================================
model MasterContract {
  id           String          @id @default(uuid())
  type         String          // "MASTER_FRANQUEADO", "MASTER_IMOBILIARIA", "FRANQUEADO_IMOBILIARIA"
  status       String          @default("Ativo")
  startDate    DateTime
  endDate      DateTime?
  value        Float
  documentUrl  String?         @db.Text

  franchiseeId String?
  franchisee   Franchisee?     @relation(fields: [franchiseeId], references: [id])
  
  realEstateId String?
  realEstate   RealEstate?     @relation(fields: [realEstateId], references: [id])

  invoices     MasterInvoice[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ==========================================
// FATURAS DO MASTER (Cobrança SaaS)
// ==========================================
model MasterInvoice {
  id               String         @id @default(uuid())
  dueDate          DateTime
  paidDate         DateTime?
  amount           Float
  status           String         @default("Pendente") // Pendente, Pago, Vencido
  description      String?

  mpPaymentId      String?
  pixQrCode        String?        @db.Text
  pixQrCodeBase64  String?        @db.Text
  ticketUrl        String?        @db.Text

  masterContractId String
  masterContract   MasterContract @relation(fields: [masterContractId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WhatsappConfig {
  id             String     @id @default(uuid())
  realEstateId   String     @unique
  realEstate     RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  instanceName   String     @unique // Nome único da instância na Evolution API (ex: zenix_imob_123)
  status         String     @default("DISCONNECTED") // DISCONNECTED, QR_READY, CONNECTED
  qrCodeBase64   String?    @db.Text // Guarda o QR code temporário
  
  botEnabled     Boolean    @default(false) // Se o robô de triagem está ligado
  welcomeMessage String?    @db.Text // Mensagem de saudação do bot
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ==========================================
// RATEIO DE COMISSÕES (SPLIT DE CORRETAGEM)
// ==========================================
model Commission {
  id              String     @id @default(uuid())
  realEstateId    String
  realEstate      RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  brokerId        String?
  broker          Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  
  contractId      String?
  propertyTitle   String     // Título do imóvel negociado
  transactionType String     // "Venda" ou "Locação"
  dealValue       Float      // Valor total da venda ou 1º aluguel
  totalCommission Float      // Valor total da comissão bruta gerada
  
  roleInDeal      String     // "Vendedor", "Captador", "Gerente", "Imobiliária"
  percentage      Float      // % que este participante recebeu no rateio
  amount          Float      // Valor em R$ líquido deste participante
  
  status          String     @default("Pendente") // "Pendente", "Pago"
  paidAt          DateTime?
  notes           String?

  // Controle de NFS-e sobre a comissão (intermediação da imobiliária ou repasse)
  nfseStatus      String?    // "PENDING", "ISSUED", "ERROR"
  nfseFocusRef    String?
  nfsePdfUrl      String?    @db.Text
  nfseXmlUrl      String?    @db.Text

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ==========================================
// AVALIADOR DE IMÓVEIS (LAUDO PTAM / ACM)
// ==========================================
model PropertyValuation {
  id                String     @id @default(uuid())
  realEstateId      String
  realEstate        RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  ownerName         String
  ownerPhone        String?
  propertyTitle     String
  address           String
  neighborhood      String
  city              String
  type              String     // Casa, Apartamento, Comercial, Terreno
  transaction       String     // Venda ou Aluguel
  
  area              Float
  bedrooms          Int        @default(0)
  bathrooms         Int        @default(0)
  garage            Int        @default(0)
  conservationState String     @default("Padrão") // "Novo/Reformado", "Padrão", "Precisa de Reforma"
  
  avgSqmPrice       Float      // Preço médio do m² calculado
  estimatedPrice    Float      // Valor justo estimado
  minPrice          Float      // Faixa mínima (Liquidez Rápida)
  maxPrice          Float      // Faixa máxima (Teto de Mercado)
  
  comparablesJson   Json       // Guarda a lista de imóveis comparáveis usados no laudo
  brokerName        String?
  brokerCreci       String?
  notes             String?    @db.Text

  createdAt         DateTime   @default(now())
}

// ==========================================
// RESERVAS DE ALUGUEL POR TEMPORADA (PMS / ICAL)
// ==========================================
model SeasonBooking {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  guestName   String?  @default("Hóspede Temporada")
  guestPhone  String?
  guestEmail  String?
  
  checkIn     DateTime
  checkOut    DateTime
  
  source      String   @default("DIRECT") // "AIRBNB", "BOOKING", "VRBO", "DIRECT", "MANUAL"
  externalUid String?  // UID único vindo do arquivo iCal da OTA (para evitar duplicatas)
  totalAmount Decimal? @db.Decimal(10, 2)
  status      String   @default("CONFIRMED") // "CONFIRMED", "CANCELLED", "PENDING"
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([externalUid])
}

// ==========================================
// DESPESAS DE CONTRATOS & IMÓVEIS
// ==========================================
model PropertyExpense {
  id              String    @id @default(uuid())
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  description     String    // Ex: "IPTU Mensal", "Manutenção de Calefação", "Condomínio"
  amount          Float     // Valor da despesa
  dueDate         DateTime  // Data de vencimento
  paidDate        DateTime? // Data de pagamento
  status          String    @default("Pendente") // "Pendente", "Pago", "Atrasado"
  
  payerType       String    // "TENANT" (Inquilino paga na fatura) ou "OWNER" (Abate do repasse)
  category        String    @default("Manutenção") // IPTU, Condomínio, Reparo Estrutural, Seguro
  documentUrl     String?   @db.Text // Comprovante ou boleto anexado

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// CONTAS A PAGAR / DESPESAS OPERACIONAIS DA IMOBILIÁRIA (DRE)
// ==========================================
model AgencyExpense {
  id              String     @id @default(uuid())
  realEstateId    String
  realEstate      RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  description     String     // Ex: "Aluguel da Sede", "Assinatura Portais (Zap/VivaReal)", "Energia"
  amount          Float      // Valor da despesa
  dueDate         DateTime   // Vencimento
  paidDate        DateTime?  // Data do pagamento
  status          String     @default("Pendente") // "Pendente", "Pago"
  category        String     @default("Operacional") // Operacional, Marketing, Impostos, Pessoal
  supplierName    String?    // Fornecedor / Credor
  documentUrl     String?    @db.Text

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ==========================================
// CONFIGURAÇÃO & INTEGRAÇÃO CONTA AZUL
// ==========================================
model ContaAzulConfig {
  id               String     @id @default(uuid())
  realEstateId     String     @unique
  realEstate       RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  accessToken      String?    @db.Text
  refreshToken     String?    @db.Text
  expiresAt        DateTime?
  isActive         Boolean    @default(false)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ==========================================
// MÓDULO INCORPORADORA: 1. SPEs & LAND BANK (VIABILIDADE)
// ==========================================
model DeveloperSpe {
  id              String               @id @default(uuid())
  realEstateId    String
  realEstate      RealEstate           @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  cnpj            String               @unique
  corporateName   String               // Razão Social da SPE
  tradeName       String               // Nome do Empreendimento / SPE
  taxRegime       String               @default("RET - Patrimônio de Afetação") // RET (4%), Lucro Presumido, etc.
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  pixKey          String?
  isActive        Boolean              @default(true)

  landBanks       LandBank[]
  projects        DevelopmentProject[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model LandBank {
  id                        String               @id @default(uuid())
  realEstateId              String
  realEstate                RealEstate           @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  speId                     String?
  spe                       DeveloperSpe?        @relation(fields: [speId], references: [id], onDelete: SetNull)

  title                     String               // Identificação da Área / Terreno
  cep                       String?
  address                   String
  neighborhood              String
  city                      String
  state                     String
  
  // Potencial Construtivo e Custos de Aquisição
  areaSqm                   Float                // Área do terreno (m²)
  utilizationCoefficient    Float                @default(1.0) // Coeficiente de Aproveitamento (CA)
  buildableAreaSqm          Float                // Área total construível (m²)
  acquisitionCost           Float                // Custo de aquisição (R$)
  swapPercent               Float                @default(0)   // % de Permuta Física/Financeira com o terreneiro
  
  // Estudo de Viabilidade Econômica (VGV, Impostos, Fluxo e Inadimplência)
  estimatedVgv              Float                // Valor Geral de Vendas projetado (R$)
  estimatedConstructionCost Float                // Custo total de obra estimado (R$)
  taxEstimatePercent        Float                @default(4.0) // Alíquota projetada (ex: RET 4%)
  defaultRiskPercent        Float                @default(3.5) // Previsão de inadimplência (%)
  projectedMarginPercent    Float                // Margem líquida projetada (%)
  cashFlowProjectionJson    Json?                // Simulação de fluxo de caixa mês a mês
  
  documentsJson             Json?                // Links de Matrícula, Sondagem, Topografia, Viabilidade Legal
  status                    String               @default("EM_ESTUDO") // "EM_ESTUDO", "APROVADO", "CONVERTIDO_EM_OBRA", "DESCARTADO"
  notes                     String?              @db.Text

  projects                  DevelopmentProject[]

  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

// ==========================================
// MÓDULO INCORPORADORA: 2. EMPREENDIMENTO, ENGENHARIA & VITRINE
// ==========================================
model DevelopmentProject {
  id                      String                    @id @default(uuid())
  realEstateId            String
  realEstate              RealEstate                @relation(fields: [realEstateId], references: [id], onDelete: Cascade)

  speId                   String?
  spe                     DeveloperSpe?             @relation(fields: [speId], references: [id], onDelete: SetNull)

  landBankId              String?
  landBank                LandBank?                 @relation(fields: [landBankId], references: [id], onDelete: SetNull)

  name                    String                    // Nome Comercial do Empreendimento
  slug                    String                    @unique // Slug para a Landing Page personalizada no site
  status                  String                    @default("LANCAMENTO") // "PRE_LANCAMENTO", "LANCAMENTO", "EM_OBRAS", "PRONTO"
  description             String?                   @db.Text
  address                 String
  neighborhood            String
  city                    String
  state                   String
  deliveryForecast        DateTime?                 // Previsão de Entrega das Chaves
  totalUnits              Int                       @default(1)
  vgvTotal                Float                     @default(0)
  accumulatedInccPercent  Float                     @default(0) // Índice INCC acumulado aplicado na carteira

  // Avanço Físico-Financeiro das Etapas (%)
  foundationPct           Float                     @default(0) // Fundação
  structurePct            Float                     @default(0) // Supraestrutura
  masonryPct              Float                     @default(0) // Alvenaria e Vedação
  installationsPct        Float                     @default(0) // Instalações Elétricas/Hidráulicas
  facadePct               Float                     @default(0) // Fachada / Design Exterior
  finishingPct            Float                     @default(0) // Acabamentos e Interiores
  overallProgressPct      Float                     @default(0) // Progresso Geral Ponderado

  // CRM Visual, Tours 360º, Renderizações e Memorial Descritivo Visual
  tour360ExteriorUrl      String?                   @db.Text // Passeio 360° da Fachada e Áreas Comuns
  tour360DecoratedUrl     String?                   @db.Text // Passeio 360° do Apartamento Decorado
  facadeRendersUrls       String[]                  // Imagens 3D de alta resolução da Fachada
  interiorRendersUrls     String[]                  // Imagens 3D dos Interiores / Áreas Comuns
  floorPlansUrls          String[]                  // Plantas Baixas Humanizadas
  visualMemorialJson      Json?                     // Memorial descritivo visual (Pisos, Louças, Fachada, Esquadrias)

  // Personalização da Página Pública no Site da Imobiliária
  showOnPublicSite        Boolean                   @default(true)
  customHeadline          String?                   // Chamada principal da Landing Page
  heroVideoUrl            String?                   @db.Text // Vídeo promocional de fundo
  primaryThemeColor       String                    @default("#0f172a")
  accentThemeColor        String                    @default("#2563eb")
  highlightsJson          Json?                     // Diferenciais do projeto (ex: Rooftop, Coworking, Vaga Verde)

  // Relacionamentos de Engenharia, BIM e Customização
  budgetItems             ConstructionBudgetItem[]
  measurements            ContractorMeasurement[]
  supplyOrders            SupplyPurchaseOrder[]
  workDiaries             WorkDiary[]
  bimFiles                BimProjectFile[]
  customizationOptions    CustomizationKitOption[]
  customizationOrders     UnitCustomizationOrder[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

// Orçamento de Obra, Curva ABC e Cronograma Físico-Financeiro
model ConstructionBudgetItem {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code               String?            // Código SINAPI / TCPO ou interno
  stageName          String             // Ex: "Fundação", "Estrutura", "Fachada", "Interiores"
  itemDescription    String             // Ex: "Concreto Usinado FCK 30MPa", "Porcelanato 90x90"
  category           String             @default("Material") // "Material", "Mão de Obra", "Equipamento", "Serviço Terceirizado"
  unit               String             @default("un") // m², m³, kg, ton, vb, un
  quantity           Float
  unitCost           Float
  totalPlannedCost   Float              // quantity * unitCost
  abcClass           String             @default("C") // Classificação automática "A" (80% custo), "B" (15%), "C" (5%)

  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  executedPercent    Float              @default(0) // % executado em campo
  actualCostSpent    Float              @default(0) // Custo real desembolsado

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Medições e Controle de Empreiteiros / Terceiros
model ContractorMeasurement {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorName     String             // Nome da Empreiteira
  contractorCnpj     String?
  serviceDescription String             // Ex: "Medição #04 - Reboco Externo Torre A"
  periodReference    String             // Ex: "Outubro/2026"
  grossAmount        Float              // Valor bruto medido
  retentionPercent   Float              @default(5.0) // % de retenção contratual (caução de garantia)
  retentionAmount    Float              // Valor retido na fonte
  netAmount          Float              // Valor líquido a pagar ao empreiteiro
  status             String             @default("PENDENTE") // "PENDENTE", "APROVADA", "PAGA_INTEGRADA_DRE"
  invoiceUrl         String?            @db.Text // Nota fiscal da medição

  measuredAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())
}

// Suprimentos, Cotações, Ordens de Compra e Estoque de Canteiro
model SupplyPurchaseOrder {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materialName       String             // Ex: "Aço CA-50 10mm", "Cimento CP-II"
  unit               String             @default("un")
  quantityOrdered    Float
  quantityInStock    Float              @default(0) // Saldo atual no estoque do canteiro
  supplierName       String
  supplierCnpj       String?
  quotesJson         Json?              // Cotações comparativas (Fornecedor 1, 2 e 3)
  totalAmount        Float
  status             String             @default("COTACAO") // "COTACAO", "ORDEM_EMITIDA", "ENTREGUE_NO_CANTEIRO"
  expectedDelivery   DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Diário de Obra (RDO)
model WorkDiary {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date               DateTime           @default(now())
  weatherMorning     String             @default("Sol") // "Sol", "Nublado", "Chuva", "Impraticável"
  weatherAfternoon   String             @default("Sol")
  workforceCount     Int                @default(0)     // Total de operários no canteiro
  workforceRolesJson Json?              // Detalhamento (Pedreiros, Serventes, Eletricistas, Engenheiros)
  activitiesExecuted String             @db.Text        // Relatório técnico do dia
  occurrences        String?            @db.Text        // Acidentes, atrasos de entrega, paralisações
  photosUrls         String[]                           // Fotos do avanço diário
  engineerName       String?

  createdAt          DateTime           @default(now())
}

// ==========================================
// MÓDULO INCORPORADORA: 3. BIM, DESIGN EXTERIOR/INTERIOR & PERSONALIZAÇÃO
// ==========================================

// Repositório BIM, Plantas e Compatibilização de Projetos
model BimProjectFile {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  discipline         String             // "Fachada / Exterior", "Design de Interiores", "Arquitetura", "Estrutural", "Hidrossanitário", "Elétrica / Iluminação", "Gesso"
  fileName           String             // Ex: "Fachada_Executivo_TorreA.ifc"
  fileFormat         String             // "IFC", "RVT", "SKP", "PROMOB", "DWG", "PDF"
  fileUrl            String             @db.Text
  version            String             @default("R00") // Controle de Revisão: R00, R01, R02...
  isLatestRevision   Boolean            @default(true)

  // Compatibilização (Clash Detection)
  clashStatus        String             @default("COMPATIBILIZADO") // "EM_ANALISE", "CONFLITO_DETECTADO", "COMPATIBILIZADO"
  clashDescription   String?            @db.Text // Ex: "Ponto de sanca de gesso conflita com prumada hidráulica no Apt Tipo"
  responsibleDesigner String?

  createdAt          DateTime           @default(now())
}

// Catálogo de Opções de Personalização de Unidades (Kit Acabamentos)
model CustomizationKitOption {
  id                 String             @id @default(uuid())
  projectId          String
  project            DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category           String             // "Pisos e Porcelanatos", "Bancadas e Marmoraria", "Louças e Metais", "Iluminação e Forro", "Automação", "Planta Flexível"
  title              String             // Ex: "Upgrade Piso Vinílico Amadeirado + Rodapé Poliestireno 15cm"
  specification      String             @db.Text // Detalhamento técnico da marca/modelo
  imageUrl           String?            @db.Text // Foto do material/ambiente renderizado
  additionalPrice    Float              // Valor adicional cobrado no aditivo (R$)
  maxStageAllowedPct Float              @default(50) // Limite de % da obra até onde o cliente pode pedir a alteração
  isActive           Boolean            @default(true)

  createdAt          DateTime           @default(now())
}

// Pedido de Personalização do Cliente -> Aditivo Contratual + Ordem de Serviço (OS) para o Canteiro
model UnitCustomizationOrder {
  id                    String             @id @default(uuid())
  projectId             String
  project               DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitNumber            String             // Ex: "Apt 1204 - Torre Única"
  buyerName             String
  buyerDocument         String?
  contractId            String?            // Vínculo opcional com o contrato do cliente no módulo de Contratos

  selectedItemsJson     Json               // Array de kits/acabamentos escolhidos pelo comprador
  totalAdditionalAmount Float              // Soma automática dos upgrades escolhidos (Valor do Aditivo)
  
  // Status Comercial / Aditivo Financeiro
  addendumStatus        String             @default("SIMULACAO") // "SIMULACAO", "AGUARDANDO_ASSINATURA", "ADITIVO_ASSINADO"
  addendumDocumentUrl   String?            @db.Text

  // Ordem de Serviço (OS) para Engenharia / Canteiro de Obras
  engineeringOsCode     String?            // Código da OS gerada para o mestre de obras/engenheiro
  engineeringOsStatus   String             @default("AGUARDANDO_ADITIVO") // "AGUARDANDO_ADITIVO", "OS_EMITIDA_CANTEIRO", "EM_EXECUCAO", "CONCLUIDO_VISTORIADO"
  engineeringInstructions String?          @db.Text // Instruções exatas do que instalar na unidade

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}