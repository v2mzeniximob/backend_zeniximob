generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS MASTER DA PLATAFORMA
// ==========================================
model MasterAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// PLANOS DE ASSINATURA
// ==========================================
model Plan {
  id           String       @id @default(uuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  modules      Json         // Array de módulos permitidos (ex: ["FINANCEIRO", "CRM"])
  hasSupport   Boolean      @default(false)
  supportPrice Decimal?     @db.Decimal(10, 2)
  isActive     Boolean      @default(true)
  
  realEstates  RealEstate[] // Relacionamento com as imobiliárias

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// FRANQUEADOS
// ==========================================
model Franchisee {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String       // Razão Social
  tradeName         String       // Nome Fantasia
  stateRegistration String?      // Inscrição Estadual
  cityRegistration  String?      // Inscrição Municipal
  cep               String
  address           String       // Endereço Completo
  phone             String
  
  // Dados do Responsável
  respName          String
  respCpf           String
  respAddress       String
  respPhone         String
  
  // Acesso à plataforma
  email             String       @unique
  password          String
  contractUrl       String?      // Link do PDF do contrato no Storage (S3/Cloudinary)
  isActive          Boolean      @default(true)

  realEstates       RealEstate[] // Lojas vinculadas a este franqueado

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ==========================================
// IMOBILIÁRIAS (LOJAS)
// ==========================================
model RealEstate {
  id                String       @id @default(uuid())
  cnpj              String       @unique
  corporateName     String
  tradeName         String
  slug              String       @unique 
  stateRegistration String
  cityRegistration  String
  cep               String
  address           String
  phone             String
  respName          String
  respCpf           String
  respPhone         String
  respAddress       String
  email             String       @unique
  password          String
  contractUrl       String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  planId            String
  plan              Plan         @relation(fields: [planId], references: [id])
  
  franchiseeId      String?
  franchisee        Franchisee?  @relation(fields: [franchiseeId], references: [id])

  properties        Property[]
  leads             Lead[]
  brokers           Broker[]
}

// ==========================================
// CORRETORES (Equipa da Loja)
// ==========================================
model Broker {
  id           String     @id @default(uuid())
  name         String
  cpf          String     @unique
  creci        String
  phone        String
  email        String     @unique
  password     String
  isActive     Boolean    @default(true)
  
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  // ATUALIZAÇÃO: Relações com Imóveis e Leads
  properties   Property[]
  leads        Lead[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ==========================================
// IMÓVEIS
// ==========================================
model Property {
  id            String      @id @default(uuid())
  title         String
  type          String      // Casa, Apartamento, Terreno, etc.
  category      String      // Residencial ou Comercial
  transaction   String      // Venda ou Aluguel
  price         Float
  area          Float
  bedrooms      Int         @default(0)
  bathrooms     Int         @default(0)
  garage        Int         @default(0)
  cep           String
  address       String
  description   String?
  imageUrls     String[]    // Array com as URLs das fotos
  isActive      Boolean     @default(true)
  
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  // ATUALIZAÇÃO: Vinculação ao Corretor
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  leads         Lead[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// LEADS (CRM)
// ==========================================
model Lead {
  id            String      @id @default(uuid())
  name          String
  phone         String
  email         String?
  interest      String      // Comprar, Alugar, etc.
  status        String      @default("Novo") // Novo, Em Atendimento, Em Proposta, Fechado, Perdido
  notes         String?
  
  propertyId    String?
  property      Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  realEstateId  String
  realEstate    RealEstate  @relation(fields: [realEstateId], references: [id], onDelete: Cascade)
  
  // ATUALIZAÇÃO: Vinculação ao Corretor que está atendendo
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}